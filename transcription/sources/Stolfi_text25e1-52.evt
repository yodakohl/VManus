# plant <f99r>[1,2] - dark

# Near top edge, West of plant <f99r>[1,3].
<f99r.4;U>         oky<$>

# plant <f99r>[1,3] - dark

# Near top edge, West of plant <f99r>[1,4] - dark
# On top of a stain.
<f99r.5;U>         salo<$>

# plant <f99r>[1,4] - dark - partly obscured by blot

