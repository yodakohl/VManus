<f99r.39;U>        sory<$>

# West of plant <f99r>[3,7], near base of stem.
# This label is a half-line higher than <f99r.L3.6>.
<f99r.40;U>        dam<$>

# plant <f99r>[3,7] - roots, light, hairy, dark leaf

