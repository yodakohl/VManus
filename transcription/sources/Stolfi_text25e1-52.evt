# plant <f99r>[1,6] - light - multiple stumps

# Near top edge, West of plant <f99r>[1,7].
<f99r.9;U>         salol<$>

# plant <f99r>[1,7] - striped - with hair

# Near top edge, West of plant <f99r>[1,8].
<f99r.10;U>        skeeal<$>

# plant <f99r>[1,8] - dark, funny shape

# Near top edge, West of plant <f99r>[1,9].
<f99r.11;U>        okary<$>

# plant <f99r>[1,9] - light, bulbous, roots bent Eastwards

# Above plant <f99r>[1a,1], below <f99r>[1,1].
<f99r.12;U>        okalo<$>

# plant <f99r>[1a,1] - dark

