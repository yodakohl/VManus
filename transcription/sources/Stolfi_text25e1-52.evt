# is entry <f75v.N3.27>.
<f75v.63;U>        <!pond>oteey.qolchey.qokey.oldy.olyly<|>

# The word at left of pond, roughly aligned with this line,
# is entry <f75v.N3.28>.
<f75v.64;U>        <!pond>s.shey.qol.dy.qokar.shey.ldy<|>

# The word at left of pond, roughly aligned with this line,
# is entry <f75v.N3.29>.
