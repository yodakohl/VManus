# Interlinear compilation of VMS transcriptions, version 25e1
# VMs text proper, without page description, attributes, etc.

@@ include text20e1-intro.txt 
@@ include text20e1-weirdos.txt 

# NOTE: Locators <e[0-9]+[rv][0-9]?> refer to Rene's version of the interlinear.

# ??? For copy-paste:
# [ONE-LEG GALLOWS CHECKED]
# The gallows are normal.
# The first gallows is a bridging @'t/T' with halves &371; and &372;.  Others are normal.
# The gallows are taller and wider but otherwise normal.

@@ f1r
# ======================================================================
<f1r>             <!$I=T $Q=A $P=A $L=A $H=1 $N=Y $K=Y>
# [ONE-LEG GALLOWS CHECKED]

# Unit <f1r.P1>: Text - parag 1.
# The big red weirdo in the upper right corner is <f1r.K1.0>.

<f1r.1;U>          zyays.ykal.ar.ytaiin.shol.shory.cthres.y.kor.sholdy<|>
<f1r.2;U>           <:>sory.ckhar.or,y.kair.chtaiin.shar.ary.cthar.cthar.dan<|>
<f1r.3;U>           <:>syaiir.sheky.or.ykaiin.shod.cthoary.ithes.daraiin.sy<|>
# The first glyph on this line is a @d partly obscured by a hole that makes it into an &136;.
<f1r.4;U>          doiin.oteey.otear.roloty.ctar.daiin.okaiin.or.okan<|>

# The right-justified part of <f1r.P1.5> was split off as <f1r.T1.6>.
<f1r.5;U>          sairy.chear.cthaiin.cphar.cfhaiin<$>

# Unit <f1r.T1>: Title 1 - right-justified part of line <f1r.P1.5>.
<f1r.6;U>          »ydaraishy<$>

# Unit <f1r.P2>: Text - parag 2.

# &C~y; = like @'Cy' with an @s-plume over the lig
<f1r.7;U>          &252;.odar.&C~y;.shol.cphoy.oydar.sh?.s.cfhoaiin.shodary<|>
<f1r.8;U>           <:>yshey.shody.okchoy.otchol.chocthy.oschy.dain.chor.kos<|>
<f1r.9;U>           <:>daiin.shos.cfhol.shody<$>

# Unit <f1r.T2>: Title 2 - right-justified part of line <f1r.P2.9>.
<f1r.10;U>         »dain.or.teody<$>

# Unit <f1r.P3>: Text - parag 3.

<f1r.11;U>         &253;.ydain.cwhesaiin.ols,cwhey.ytain.shoshy.cphodales<|>
<f1r.12;U>          <:>oksho.kshoy.otairin.oteol.okan.shodain.sckhey.daiin<|>
<f1r.13;U>          <:>shoy.ckhey.kodaiin.cphy.cphodaiils.&CTH@;y.shy.oldain.d?<!@i is backwards><|>
<f1r.14;U>         dain.oiin.chol.odaiin.chodain.chdy.okain.dain.cthy.kod?<|>

# &CK; = a @C ligd to a platf gallows @K that does NOT ligate to the next glyph.
<f1r.15;U>         daiin.shckhey.ckeor.chor.shey.kol.chol.chol.kor.chal<|>
<f1r.16;U>          <:>sho.chol.shodan.kshy.kchy.dor.chodaiin.sho.koeam<|>

# &CTOy; = a @C ligd to platf gallows @T then across raised @o and to top of @y
<f1r.17;U>         ycho.tchey.chekain.sheo.wshol.dydyd.cthy.dai&CTOy;<|>
<f1r.18;U>          <:>yto.shol.shy.kodshey.cphealy.darain.dain.ckhyds<|>

# &-'; = the lig stroke of @c (without the @e stroke) with an @s-plume.
# &CPo; = a @C ligd to a platf gallows @P ligd to the top of @o.
# &ct; = a @C ligd to a NON-platf gallows @t.
<f1r.19;U>         dchar.shcthaiin.okaiir,chey.&-';chy.&130;tol.cthols.dao&ct;a<|>

# The right-justified part of <f1r.P3.20> was split off as <f1r.T3.21>.
<f1r.20;U>         shok.chor.chey.dain.ckhey<$>

# Unit <f1r.T3>: Title 3 - right-justified part of line <f1r.P3.20>.
<f1r.21;U>         »otol.daiiin<$>

# Unit <f1r.P4>: text - parag 4.

# The gallows are taller and wide but otherwise normal.
<f1r.22;U>         cpho.shaiin.shokcheey.chol.tshodeesy.shey.pydeey.chy.ro.dar<|>
<f1r.23;U>          <:>ydain.chol.dain.cthal.dar.shear.kaiin.dar.shey.cthar<|>
<f1r.24;U>          <:>chy.???.kaiin.shoaiin.okol.daiin.far.cthol.daiin.ctholdar<|>
<f1r.25;U>          <:>ycheey.okeey.oky.daiin.okchey.kokaiin.okchol.kydchy.dal<|>
<f1r.26;U>          <:>dcheo.shody.koshey.cthy.okchey.keey.keey.dal.chtor<|>

# The right-justified part of <f1r.P4.27> was split off as <f1r.T4.28>.
<f1r.27;U>         sho?.chol.chok.choty.chotey<$>

# Unit <f1r.T4>: Title 4 - right-justified part of line <f1r.P4.27>.
<f1r.28;U>         »dchaiin<$>

# Unit <f1r.K1>: Three-way letter table ("key sequence") in right margin.
# Believed to have been added by Marci.
# The Roman text is given as inline comments "<!R:...>", where "<!R:>" denotes a blank
# entry, "<!R:?>" means illegible. Many lines are extrapolated, and some
# are hihgly uncertain (e.g. <!R:j>, <!R:w>).

# Large red weirdo in the upper right corner, partly erased.

# These letters in the margin are believed to have been added by 
# some late owner:
# 
# <f1r.K1.2;U>      <!R:a>?<!R:?>=
# <f1r.K1.3;U>      <!R:b>a<!R:?>=
# <f1r.K1.4;U>      <!R:c>?<!R:?>=
# <f1r.K1.5;U>      <!R:d>?<!R:?>=
# <f1r.K1.6;U>      <!R:e>?<!R:f>=
# 
# <f1r.K1.16;U>     <!R:o>?<!R:p>=
# <f1r.K1.17;U>     <!R:p>?<!R:r>=
# 
# <f1r.K1.20;U>     <!R:s>?<!R:?>=

@@ f1v
# ======================================================================
<f1v>             <!$I=H $Q=A $P=B $L=A $H=1>
# [ONE-LEG GALLOWS CHECKED]

# Unit <f1v.P1>: Text.

# Transcriber ;E says that the final @'am' may be a correction.
<f1v.1;U>          kchsy.chydaiin.ol-<!®>oltchey.char.czhar,am<|>

<f1v.5;U>          wotoy.shol.dair.cwhoal-<!®>dar.chey.tody.otoaiin.shoshy<|>

# The initial @'qo' has a high overbar that spans from the apex of the @q to beyond the @o.  A new weirdo?
# There is a wormhole between the last @'ch' and next @o, mistaken as glyph by some.
<f1v.7;U>          qo.ol,ihoees.cheol.dol.cthey-<!®>ykol.dol.dolo.ykol.do,lchody<|>

# The plume on &366; is faint and may seem a distinct type of plume to some readers.
<f1v.9;U>          shor.okal.chol.dol.ky.dar-<!®>shol.dchor.o,tcho.dar.&366;ody<|>

# &O~h; = like @o ligd to @h. (But the reading by ;I> is wrong, it is just @'or'.)
<f1v.10;U>         taor.chotchey.dal.chody-<!®>schody.pol.chodar<$>

@@ f2r
