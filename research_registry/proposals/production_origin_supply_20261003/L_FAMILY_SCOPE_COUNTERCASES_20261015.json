{
  "title": "Manual L-family scope comparison: two fixed directional bindings meet retained counterexamples",
  "created_utc": "2026-10-15T06:16:34.553078+00:00",
  "idea": "IDEA001056",
  "status": "B2_RIGHT_AND_B3_LEFT_CONTRACTS_CONTRADICTED",
  "phase": "Exploratory construction on already exposed, admitted contexts. No blind test, new native census, parser or semantic selection.",
  "question": "Can a shared L expression type resolve the old B cheol-chol ambiguity, with one compulsory direction of explicit argument binding?",
  "predecessor": "research_registry/proposals/production_origin_supply_20261003/L_FAMILY_ARGUMENT_BINDING_DRAFT_20261015.json",
  "preservation": "R0, A and B bytes and their failures/ambiguity remain unchanged. B2 and B3 are separately declared developmental constructions, not repairs of completed tests.",
