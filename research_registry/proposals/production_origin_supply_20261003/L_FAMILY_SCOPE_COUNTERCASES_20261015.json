  "common_contract": {
    "forms": "Only exact whole Xol and Xeol with X in CORE13. No stripping initial y; ysheol and qotchol remain outside this inventory. No DY interpretation or universal e meaning.",
    "type": "Every F_X:E->E. A safe non-L whole group supplies an opaque E expression. These are unasserted expressions, not truth-valued propositions; this is an explicit change from the older P_X notation.",
    "topic": "The entire first raw paragraph group declares a fixed T and is consumed only in that position. It does not also enter the body. Unknown later groups never update T. This is an unproved positional hypothesis, not an identified subject or name.",
    "base": "Xol contributes the complete E expression F_X(T).",
    "boundaries": "Own-reader marked paragraphs are hard scope boundaries. Definite within-paragraph physical wraps are transparent. Uncertain groups/gaps or drawing interruptions must not be skipped to obtain an argument; affected binding remains open.",
    "repetition": "No idempotence, commutativity, deletion or intensity value is assumed. A paragraph yields an ordered expression sequence, not a recovered sentence or one forced tree."
  },
  "B2": {
    "rule": "Prefix/right recursion: Xeol consumes the next complete expression and yields F_X(that expression). Expanded_X Expr is itself an Expr.",
    "local_consequence": "IT f24r.18 cheol chol becomes one nested F_ch(F_ch(T24)); following daiin, the second chol and s remain separate. T24 is porory from paragraph line1, not line18 y.",
    "counterexample": {
      "reader": "IT2a",
      "locus": "f102v1.24",
      "raw_text": "ysaiin ckhey qoor cheol",
      "target": "IT2a|f102v1.24|G004",
      "paragraph_end": "1",
      "outcome": "UNBOUND_RIGHT_ARGUMENT"
    },
    "reason": "The last cheol has no following written expression within the declared paragraph. No topic fallback or crossing the end was supplied.",
    "reader_sensitivity": "ZL has the same whole line, definite inner gaps and its own paragraph_end=1. RF flags are not borrowed."
  },
  "B3": {
    "rule": "Postfix/left recursion: an Atom or Base appends one E expression. Xeol consumes only the immediately preceding complete body expression and replaces it by F_X(that expression). It cannot use the consumed topic position.",
    "development_basis": "Designed after seeing the B2 end counterexample; its fitting that same end is not independent confirmation. Applied globally, not chosen left or right per occurrence.",
    "counterexample": {
      "reader": "IT2a",
      "locus": "f103r.18",
      "raw_prefix": [
        "polchedy",
        "qokeol",
        "okain"
      ],
      "target": "IT2a|f103r.18|G002",
      "paragraph_start": "1",
      "outcome": "UNBOUND_LEFT_ARGUMENT"
    },
    "reason": "After polchedy is consumed as T, no body expression exists for qokeol. qok is in CORE13. All relevant groups and inner gaps are definite.",
    "reader_sensitivity": "Existing GDT1259 ZL certificate0 independently preserves the same three raw groups with own paragraph_start=1. Later line segmentation differs: ZL oteeylshedy versus IT oteey lshedy. No full-line equality or independent manuscript replication is claimed."
  },
