        "infants least, particularly lively infants"
      ],
      "I.14": [
        "growing bodies greatest innate heat",
        "therefore greatest food requirement",
        "otherwise bodily wasting",
        "old people weak heat",
        "therefore little fuel",
        "much fuel would extinguish flame",
        "old-age fevers less acute",
        "because old bodies cold"
      ],
      "I.15": [
        "Winter AND Spring",
        "bowels naturally hottest",
        "sleep most prolonged",
        "most sustenance in those seasons",
        "belly innate heat explicitly given as reason for greatest food need",
        "young people and athletes cited as evidence"
      ]
