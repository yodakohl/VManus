  "complete": false,
  "added_lexical_definitions": {
    "cthor": "Inspect and mark the already written current recipient boundary; Surface/Region -> same recipient",
    "ylchdy": "Preserve the immediately preceding deposited Layer visibly beside the latest Layer on the same base Surface",
    "shcthy": "Apply active Paint to current written recipient, creating a fresh deposited Layer",
    "qoly": "Leave the preceding deposited Layer visibly discernible beside the latest Layer on the same base Surface",
    "tol": "Return recipient reference from a Region to its explicitly written parent Surface; Surface input is retained",
    "tain": "cohesive physical property of Paint",
    "y": "Allow active Paint to settle; Paint -> same Paint, no queue consumption",
    "kiin": "aqueous liquid Ingredient",
    "ldy": "Allow current Layer to set; Layer -> same Layer",
