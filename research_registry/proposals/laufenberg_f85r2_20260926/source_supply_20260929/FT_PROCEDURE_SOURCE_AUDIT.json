  "reproduction_python": "from pathlib import Path\nimport csv,io,json,hashlib,subprocess,collections\nbase=Path(\"research_registry/proposals/laufenberg_f85r2_20260926/source_supply_20260929\")\nsha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()\naudit=json.loads((base/\"FT_PROCEDURE_SOURCE_AUDIT.json\").read_text())\npacket=json.loads((base/\"FT_SOURCE_PACKET.json\").read_text())\ninputs=json.loads((base/\"FT_DRAFT_INPUTS.json\").read_text())\nassert all(sha(r[\"path\"])==r[\"sha256\"] for r in inputs[\"inputs\"])\nassert sha(base/\"FT_SOURCE_PACKET.json\")==\"31de602d3d3a6b1c58caf5563159a3f757fe05995971f9319b769c4bbb95fa26\"\nassert sha(base/\"FT_ACCOUNTING_VALIDATOR.py\")==\"385fafc7e5be8683237cfaf93d91c2d957addb0e4824babe0dca7bf8f82732ce\"\nassert sha(base/\"FT_ACCOUNTING_VALIDATION.json\")==\"1d8383a062be66bc5d1bc146c4269ea07cfe6114449480cf212b2cb9c82b2486\"\nauthor=json.loads((base/\"FT_AUTHOR_PROCEDURE.json\").read_text())\nassert author[\"shared_packet_sha256\"]==sha(base/\"FT_SOURCE_PACKET.json\")\nassert author[\"derivation_sha256\"]==sha(base/\"FT_PROCEDURE_DERIVATION.tsv\")\nrun=subprocess.run(audit[\"guard_command\"],text=True,capture_output=True,check=True)\nassert hashlib.sha256(run.stdout.encode()).hexdigest()==audit[\"projection_sha256\"]\nstats=[json.loads(s[len(\"GUARD_STATS \"):]) for s in run.stderr.splitlines() if s.startswith(\"GUARD_STATS \")]\nassert stats==[{\"selected\":655,\"skipped_forbidden\":0,\"skipped_not_allowed\":0}]\nrows=list(csv.DictReader(io.StringIO(run.stdout),delimiter=\"\\t\"))\nsource={g[\"source_group_id\"]:{\"unit_id\":c[\"unit_id\"],**g} for c in packet[\"contexts\"] for g in c[\"groups\"]}\nassert len(rows)==len(source)==len({r[\"source_group_id\"] for r in rows})==655\nassert {r[\"source_group_id\"] for r in rows}==set(source)\nassert {r[\"locus\"] for r in rows}=={g[\"locus\"] for g in source.values()}\nassert all(all(r[k]==str(source[r[\"source_group_id\"]][{\"raw_group\":\"ivtff_group_raw\"}.get(k,k)]) 