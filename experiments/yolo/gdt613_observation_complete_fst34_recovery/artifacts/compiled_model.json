    "composite_output_length_max": 12,
    "connector_only_chunk_penalty_required": true,
    "contextual_allomorphs_per_primitive_max": 3,
    "edge_connector_penalty_required": true,
    "states": [
      "START",
      "LEFT",
      "CORE",
      "LINK",
      "RIGHT",
      "WHOLE",
      "END"
    ]
  },
