  "transcription": [
    {
      "face": "recto",
      "lines": [
        {
          "n": 1,
          "text": "פיפסד פיהא. ומן אלנאס מן יגֹפף אלמשמש וינקעה פי"
        },
        {
          "n": 2,
          "text": "אלמא אלבארד וישרב דלך אלמא עלי אלריק ללתבריד"
        },
        {
          "n": 3,
          "text": "ואלתטפיה. וינבגי למן אראד אכל אלמשמש אלטרי"
        },
        {
          "n": 4,
          "text": "אן יתבעה באלסכנגֹבין אלעסלי או באלמיבה אלממסכה"
        },
        {
          "n": 5,
          "text": "אלכוך. בארד רטב מולד ללבלגם ואלגדא"
        },
        {
          "n": 6,
          "text": "אלמתולד מנה אגלטֹ מן אלגדא אלמתולד מן אלמשמש"
        },
        {
          "n": 7,
          "text": "וליס יפסד פי אלמעדה כפסאד אלמשמש. ומא כאן;"
        },
        {
          "n": 8,
          "text": "מן אלכוך רכו ינתזע מנה נואה בסהולה פהו אסרע"
        },
        {
          "n": 9,
          "text": "אנהצֹאמא ואנחדארא ען אלמעדה. ומא כאן מנה"
        },
        {
          "n": 10,
          "text": "מלתצקא בנואה וגֹוהרה צלב מנדמגֹ והו אלגֹבלי פהו"
        },
        {
          "n": 11,
          "text": "אגלטֹ ואבטא אנהצֹאמא. ומתי אכלה אצחאב"
        },
        {
          "n": 12,
          "text": "אלמזאגֹ אלבארד פליאכלו בעדה זנגֹבילא מרבא או"
        },
        {
          "n": 13,
          "text": "עסל אלנחל או שראב אלעסל. אלרמֹאן"
        },
        {
          "n": 14,
          "text": "בארד ומא כאן מנה חאמצֹא פהו קוי אלברד מעתדל"
        },
        {
          "n": 15,
          "text": "אלרטובה ואליבס קאמעא ללצפרא מקויא ללמעדה"
        },
        {
          "n": 16,
          "text": "ואלכבד אלחארתין מסכן ללקי. וחב אלרמאן אלחאמץֹ"
        },
        {
          "n": 17,
          "text": "אדא גֹפף עקל אלטביעה ומנע אלמואד אלצפראויה"
        },
        {
          "n": 18,
          "text": "מן אלאנצבאב אלי אלבטן. ואלרמאן אלחלוא מעתדל פי"
        },
        {
          "n": 19,
          "text": "אלחרארה ואלברודה והו רטב אלמזאגֹ. ואלנוע אלמערוף"
        },
        {
          "n": 20,
          "text": "מנה באלמליסי אללין אלעגֹס ינפע מן אלסעל אלחאדא"
        },
        {
          "n": 21,
          "text": "מן חרארה והו מולד ללריאח פי אלמעדה אלבארדה"
        }
      ]
    },
    {
      "face": "verso",
      "lines": [
        {
          "n": 1,
          "text": "ודכר בקראט פי כתאב אפידימיא אן אמראה כאן"
        },
        {
          "n": 2,
          "text": "יוגֹעהא פואדהא אעני פם מעדתהא וכאן יסכנה ענהא"
        },
        {
          "n": 3,
          "text": "מא אלרמאן מע סויק אלשעיר ודלך אן אלוגֹע כאן יערץֹ"
        },
        {
          "n": 4,
          "text": "להא מן מראר כאן ינצב אלי פם מעדתהא פכאן מא"
        },
        {
          "n": 5,
          "text": "אלרמאן יטפי דלך ואלסויק ינשפה. אלספרגֹל"
        },
        {
          "n": 6,
          "text": "בארד יאבס קאבץֹ ללמעדה אלחארה עאקל ללטביעה"
        },
        {
          "n": 7,
          "text": "אדא אכל קבל אלטעאם. וילין אלטביעה אדא אכל בעד"
        },
        {
          "n": 8,
          "text": "אלטעאם וגדאוה כתיר. ומא כאן מנה גיר נצֹיגֹ פהו עסר"
        },
        {
          "n": 9,
          "text": "אלאנהצֹאם בטי אלאנחדאר ען אלמעדה קוי אלחבס"
        },
        {
          "n": 10,
          "text": "ללטביעה. ומא כאן מן אלספרגֹל חאמצֹא פמזאגֹה"
        },
        {
          "n": 11,
          "text": "בארדֹֹֹ פי אלתאניה יאבס פי אלתאלתה ומא כאן מנה חלוא"
        },
        {
          "n": 12,
          "text": "פהו מעתדל אלמזאגֹ פי אלחרארה ואלברודה וכל מא כאן"
        },
        {
          "n": 13,
          "text": "אשד קבצֹא פהו אכתר יבסא. ומאוה אשד תקויה ללמעדה"
        },
        {
          "n": 14,
          "text": "ואקל חבסא ללטביעה וגֹרמה אשד חבסא"
        },
        {
          "n": 15,
          "text": "אלתֹפאחֹ . מנה חאמץֹֹ והו בארד יאבס מקו"
        },
        {
          "n": 16,
          "text": "ללמעדה אלצפראויה ואקואהא פי הדא אלפעל الحلوا"
        },
        {
          "n": 17,
          "text": "ואלסוקא פי؟ אלמר. ומא כאן מנה פגֹא קאבצֹא פהו חאבס;"
        },
        {
          "n": 18,
          "text": "ללטביעה עסר אלאנהצֹאם. ומא כאן מנה חלוא"
        },
        {
          "n": 19,
          "text": "נצֹיגֹא פהו מעתדל פי אלחרארה ואלברודה"
        },
        {
          "n": 20,
          "text": "ואלשאמי מנה אעדל אנואע אלתפאח ואגֹודה גדא"
        },
        {
          "n": 21,
          "text": "ואכתר תקויה ללמעדה ואלקלב לטיב ראיחתה ומן"
        }
      ]
    },
    {
      "face": "verso, right margin",
      "lines": [
        {
          "n": 1,
          "text": "קאל בן רצֹואן אלתפאח אלנצֹיגֹ גֹיד ינבגי"
        },
        {
          "n": 2,
          "text": "אן יטעם באלכבז לתקויה בטן"
        },
        {
          "n": 3,
          "text": "אלדי לא ישתהא לטעם ואלאכתאר מן אכלה אעתדאה"
        },
        {
          "n": 4,
          "text": "[......] וגֹע אל...כאציה"
        }
      ]
    }
  ],
