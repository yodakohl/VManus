aris.fr\/api\/media\/223520","o:id":223520},{"@id":"https:\/\/alexandrine-bibnum.beauxartsparis.fr\/api\/media\/223521","o:id":223521},{"@id":"https:\/\/alexandrine-bibnum.beauxartsparis.fr\/api\/media\/223522","o:id":223522}],"o:item_set":[{"@id":"https:\/\/alexandrine-bibnum.beauxartsparis.fr\/api\/item_sets\/2","o:id":2},{"@id":"https:\/\/alexandrine-bibnum.beauxartsparis.fr\/api\/item_sets\/13509","o:id":13509},{"@id":"https:\/\/alexandrine-bibnum.beauxartsparis.fr\/api\/item_sets\/13512","o:id":13512}],"o:site":[{"@id":"https:\/\/alexandrine-bibnum.beauxartsparis.fr\/api\/sites\/1","o:id":1}],"dcterms:title":[{"type":"literal","property_id":1,"property_label":"Title","is_public":true,"@value":"Ms.Mas 116 Tractatus de herbis"}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"Recueil d\u0027images d\u0027histoire naturelle, class\u00e9es alphab\u00e9tiquement.Dessins \u00e0 la plume rehauss\u00e9s de gouache. Simples l\u00e9gendes en latin, sans texte. A des plantes pos\u00e9es \u00e0 plat comme dans un herbier s\u0027ajoutent des animaux et par endroits des sc\u00e8nes figur\u00e9es (page de Homine)."},{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"Version sans texte, compos\u00e9e uniquement d\u0027illustrations"},{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"L\u0027iconographie de la plupart des plantes est copi\u00e9e du Tractatus de herbis de Manfredus de Monte Imperiale (Paris, B.n., Lat. 6823). D\u0027autres ont \u00e9t\u00e9 peintes probablement d\u0027apr\u00e8s nature (Lilium, p.206) ; les animaux et les sc\u00e8nes figur\u00e9es proviennent souvent du Liber medicinae de animalibus, qui suit le Tractatus sur le Lat.6823. Le style, toutefois plus r\u00e9aliste, plus sensible et plus d\u00e9licat est \u00e0 rapprocher du manuscrit de Guiron le courtois (Paris, B.n., ms. n.a.fr. 5243), qui a \u00e9t\u00e9 attribu\u00e9 \u00e0 Altichieri ou Jacopo Avanzi, deux artistes ayant travaill\u00e9 \u00e0 Padoue avant 1376-1379."}],"dcterms:creator":[{"type":"literal","property_id":2,"property_label":"Creator","is_public":true,"@value":"Anonyme"}],"dcterms:source":[{"type":"literal","property_id":11,"property_label":"Source","is_public":true,"@value":"Ms.Mas 116"}],"dcterms:format":[{"type":"literal","property_id":9,"property_label":"Format","is_public":true,"@value":"Haut. en cm : 37"},{"type":"literal","property_id":9,"property_label":"Format","is_public":true,"@value":"Larg. en cm : 26,5"},{"type":"literal","property_id":9,"property_label":"Format","is_public":true,"@value":"Encre sur parchemin"}],"dcterms:type":[{"type":"literal","property_id":8,"property_label":"Type","is_public":true,"@value":"Manuscrit ou miniature"}],"dcterms:provenance":[{"type":"literal","property_id":51,"property_label":"Provenance","is_public":true,"@value":"Donation Masson, Jean"}],"dcterms:created":[{"type":"literal","property_id":20,"property_label":"Date Created","is_public":true,"@value":"1370 : (Apr\u00e8s\/\u00e0 partir de)"}],"dcterms:coverage":[{"type":"literal","property_id":14,"property_label":"Coverage","is_public":true,"@value":"Herbiers"}],"o-module-group:group":[]}